+} | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $logDir 'run.json') -Encoding utf8
+Write-Host "Evidence directory: $logDir"
 try {
     & ($Drive + '\gradlew.bat') -p ($Drive + '\') test --rerun-tasks --console=plain 2>&1 | Tee-Object -FilePath (Join-Path $logDir 'green.log')
     $testExit = $LASTEXITCODE
